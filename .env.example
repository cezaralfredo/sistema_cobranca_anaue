# ===== MongoDB =====
# No Docker, use o nome do serviço: mongodb
MONGODB_URI=mongodb://mongodb:27017/
MONGODB_DB_NAME=sistema_assinaturas

# ===== Evolution API (WhatsApp) =====
# Se Evolution API rodar no HOST (fora do Docker), use host.docker.internal (Linux/Mac/Win Docker Desktop)
# Se Evolution API rodar em outro container na mesma rede, use o nome do serviço
WHATSAPP_API_URL=http://host.docker.internal:8080
WHATSAPP_INSTANCE=anaue
WHATSAPP_API_KEY=AnaueToken2026Secure
WHATSAPP_DELAY_MIN=10
WHATSAPP_DELAY_MAX=30
WHATSAPP_TIMEOUT=30
WHATSAPP_RETRIES=3

# ===== SMTP (E-mail) =====
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_de_app_aqui

# ===== Timezone (para cron) =====
TZ=America/Sao_Paulo